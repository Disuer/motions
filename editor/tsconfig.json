{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // No baseUrl: TS 7 removed it. Paths without it resolve relative to this file, which is what
    // the "@/src" alias in vite.config.ts already assumes.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
